# Kept out of every image build (Dockerfile and deploy/ops.Dockerfile both
# build from the repository root). Above all: nothing secret, and nothing
# built on this computer.
.git
.gitignore
.dockerignore
node_modules
**/node_modules
.next
out
coverage
*.tsbuildinfo

# Secrets and local settings must never be copied into an image.
.env*
credentials
*.pem
.vercel
.claude

# Not needed to build or run anything.
docs
*.md
