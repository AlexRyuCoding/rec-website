# The one place these versions are pinned. Read by the local stack
# (deploy/local/docker-compose.yml), the tests (scripts/test-rest.sh), the
# ops image (deploy/ops.Dockerfile) and the deploy (cloudbuild.yaml).
# Plain KEY=value lines only: it is read both as a shell file and as a
# Docker Compose env file.

# The Postgres major of the Supabase project being left (PostgreSQL 17.6).
# Cloud SQL runs the same major, and the ops image's pg_dump must be at
# least this new to read the old database.
POSTGRES_MAJOR=17

# Chosen by test, not copied from Supabase: Supabase's dashboard no longer
# shows which PostgREST it runs. This is the newest stable release (image
# tag of postgrest/postgrest) on 2026-11-22, and every case in
# src/lib/db-rest.integration.test.ts passes against it. Raise it only
# with `npm run test:rest` green.
POSTGREST_VERSION=v16.6

# Google's connector between the PostgREST container and Cloud SQL
# (image tag of gcr.io/cloud-sql-connectors/cloud-sql-proxy; no "v").
# The newest 2.x release on 2026-11-22.
CLOUD_SQL_PROXY_VERSION=2.28.0
